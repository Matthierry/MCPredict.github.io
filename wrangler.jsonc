{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcpredict-beta",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "0 12-18 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcpredict-beta-db",
      "database_id": "8573cc1a-5660-4b3b-8c77-6f805ec36aff",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "beta"
  },
  "routes": [
    {
      "pattern": "beta.mcpredict.com",
      "custom_domain": true
    }
  ]
}
